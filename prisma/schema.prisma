// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id                    String   @id @default(cuid())
  name                  String
  category              String
  manufacturer          String
  msrp                  Float
  imageUrl              String?
  description           String
  whyPeopleRegret       String
  marketingHypeScore    Float    @default(0) // 0-10 scale
  actualUsefulnessScore Float    @default(0) // 0-10 scale
  remorseScore          Float    @default(0) // 0-100 scale
  totalReviews          Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  reviews               Review[]
  useCases              UseCase[]

  @@index([category])
  @@index([remorseScore])
}

model Review {
  id                    String   @id @default(cuid())
  productId             String
  authorName            String
  purchasePrice         Float?
  purchaseDate          DateTime?
  usageDuration         String   // e.g., "3 months", "1 year"
  story                 String   // User's regret story
  whatTheyWanted        String   // What they thought they needed it for
  whatTheyActuallyUsed  String   // What they actually ended up using
  marketingHypeRating   Int      // 1-10
  actualUsefulnessRating Int     // 1-10
  remorseLevel          Int      // 1-100
  wouldRecommend        Boolean  @default(false)
  upvotes               Int      @default(0)
  createdAt             DateTime @default(now())

  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
}

model UseCase {
  id                    String   @id @default(cuid())
  productId             String
  intendedUseCase       String   // What the user wanted to do
  recommendation        String   // Honest advice
  alternatives          String   // Better alternatives
  moneySaved            Float?   // Potential savings
  createdAt             DateTime @default(now())

  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Category {
  id                    String   @id @default(cuid())
  name                  String   @unique
  description           String
  icon                  String?
  createdAt             DateTime @default(now())
}
