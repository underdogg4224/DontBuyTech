# ============================================================================
# DontBuyTech Environment Configuration
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase Configuration
# ----------------------------------------------------------------------------
# Get these values from your Supabase project settings:
# https://app.supabase.com/project/_/settings/api

# Public URL for your Supabase project
# Format: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url

# Public anonymous key (safe to use in client-side code)
# This key has Row Level Security (RLS) restrictions
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key (DANGEROUS - only use server-side!)
# This key bypasses Row Level Security - handle with care
# Only use in API routes or server components
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ----------------------------------------------------------------------------
# Database Configuration (Drizzle ORM)
# ----------------------------------------------------------------------------
# PostgreSQL connection string for Drizzle ORM
# Format: postgresql://user:password@host:port/database
# For Supabase, you can find this in:
# Project Settings -> Database -> Connection String (Direct connection)
# Note: Use the "Direct connection" string, not the pooler
DATABASE_URL=your-database-connection-string

# ----------------------------------------------------------------------------
# AI Configuration (Anthropic Claude)
# ----------------------------------------------------------------------------
# API key for Claude AI integration
# Get your key from: https://console.anthropic.com/settings/keys
# Used for AI-powered product analysis and recommendations
ANTHROPIC_API_KEY=your-anthropic-api-key

# ----------------------------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------------------------
# Public URL of your application
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment
# Options: development | production | test
NODE_ENV=development

# ----------------------------------------------------------------------------
# Optional: Additional Configuration
# ----------------------------------------------------------------------------
# Uncomment and configure these if needed:

# Enable debug mode for detailed logging
# DEBUG=false

# Session secret for authentication (generate a random string)
# NEXTAUTH_SECRET=your-nextauth-secret

# Analytics and monitoring (if using)
# NEXT_PUBLIC_GA_ID=your-google-analytics-id
# SENTRY_DSN=your-sentry-dsn

# Email service configuration (if using)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@dontbuytech.com
